# openai
OPENAI_MODEL = gpt-6-luna
OPENAI_API_KEY = your_api_key_openai

# qdrant
QDRANT_API_KEY = your_qdrant_api_key
QDRANT_URL = http://localhost:6333

# PostgreSQL
POSTGRES_DB=receipt_ai
POSTGRES_USER=receipt_user
POSTGRES_PASSWORD= your_postgre_password

# Application database connection for Docker Compose.
# Use host port 5435 only when running the backend directly on your computer.
DATABASE_URL=postgresql+psycopg://receipt_user:your_postgre_password@postgres:5432/receipt_ai

#langfuse
LANGFUSE_TRACING = true # true or false
LANGFUSE_SECRET_KEY=langfuse_sk
LANGFUSE_PUBLIC_KEY=langfuse_pk
LANGFUSE_BASE_URL="https://jp.cloud.langfuse.com"

# frontend
BACKEND_URL=http://localhost:8000
